{
  "name": "agro-ai-appium-tests",
  "version": "1.0.0",
  "description": "Appium E2E Mobile Test Suite for AGRO AI Application",
  "main": "index.js",
  "scripts": {
    "test": "wdio run wdio.conf.js",
    "test:android": "PLATFORM=android wdio run wdio.conf.js",
    "test:ios": "PLATFORM=ios wdio run wdio.conf.js",
    "test:login": "wdio run wdio.conf.js --suite login",
    "test:dashboard": "wdio run wdio.conf.js --suite dashboard",
    "test:plant": "wdio run wdio.conf.js --suite plant",
    "test:ai": "wdio run wdio.conf.js --suite ai",
    "test:nutrition": "wdio run wdio.conf.js --suite nutrition",
    "generate:report": "node utils/excel-reporter.js",
    "appium:start": "appium --port 4723 --allow-insecure chromedriver_autodownload",
    "emulator:start": "emulator -avd Pixel_4_API_30 -no-snapshot-load"
  },
  "keywords": [
    "appium",
    "wdio",
    "mobile",
    "agro-ai",
    "e2e"
  ],
  "author": "AGRO AI QA Team",
  "license": "MIT",
  "dependencies": {
    "chai": "^4.3.10",
    "moment": "^2.29.4",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@wdio/allure-reporter": "^8.27.0",
    "@wdio/appium-service": "^8.27.0",
    "@wdio/cli": "^8.27.0",
    "@wdio/local-runner": "^8.27.0",
    "@wdio/mocha-framework": "^8.27.0",
    "@wdio/spec-reporter": "^8.27.0",
    "appium": "^2.4.1",
    "appium-uiautomator2-driver": "^2.34.0",
    "appium-xcuitest-driver": "^5.12.0",
    "chromedriver": "^120.0.0",
    "dotenv": "^16.3.1",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0",
    "wdio-mochawesome-reporter": "^3.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
