# AGRO AI — Codespaces / local development
APP_NAME="AGRO AI"
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Local inference. No paid API key is required.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Small text model for chat; vision-capable Qwen2.5-VL for uploaded images.
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_SECONDS=360
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_CTX=2048
# Smaller images/context are less likely to exhaust memory on 16 GB laptops.
OLLAMA_IMAGE_MAX_SIDE=256
OLLAMA_IMAGE_JPEG_QUALITY=60
OLLAMA_VISION_NUM_PREDICT=160

# Replace this with a unique random secret in any shared/production deployment.
JWT_SECRET_KEY=replace-this-with-a-random-secret

# Optional: Codespaces port forwards the Vite frontend and FastAPI API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
OLLAMA_PRELOAD_VISION=true
OLLAMA_PRELOAD_CHAT=true
