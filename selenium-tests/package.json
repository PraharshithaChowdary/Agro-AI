{
  "name": "@agro-ai/selenium-tests",
  "version": "1.0.0",
  "description": "AGRO AI Selenium E2E Test Suite — 300+ Web Tests",
  "main": "run-tests.js",
  "scripts": {
    "test": "mocha --timeout 30000 --reporter mochawesome --reporter-options reportDir=reports,reportFilename=mochawesome tests/**/*.js",
    "test:headless": "HEADLESS=true npm test",
    "test:report": "npm test && node utils/excel-reporter.js",
    "report": "node utils/excel-reporter.js"
  },
  "dependencies": {
    "chai": "^4.4.1",
    "chromedriver": "^123.0.0",
    "mocha": "^10.4.0",
    "mochawesome": "^7.1.3",
    "selenium-webdriver": "^4.18.1",
    "xlsx": "^0.18.5"
  },
  "keywords": [
    "selenium",
    "e2e",
    "testing",
    "agro-ai"
  ],
  "author": "AGRO AI Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
