# Prefer the repository-root .env file. This is a fallback for running backend separately.
HOST=0.0.0.0
PORT=8000
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Small text model for chat; vision-capable Qwen2.5-VL for uploaded images.
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_VISION_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT_SECONDS=360
OLLAMA_KEEP_ALIVE=0
OLLAMA_NUM_CTX=3072
# Smaller images/context are less likely to exhaust memory on 16 GB laptops.
OLLAMA_IMAGE_MAX_SIDE=896
OLLAMA_IMAGE_JPEG_QUALITY=82
OLLAMA_VISION_NUM_PREDICT=700


# Real SMTP Email OTP Delivery Configuration
# For Gmail, use smtp.gmail.com with a 16-character Google App Password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="AGRO AI Security"
